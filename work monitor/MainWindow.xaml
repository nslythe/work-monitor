<Window x:Class="work_monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:work_monitor"
        mc:Ignorable="d"
        Title="Work Monitor"
        Height="600" Width="580"
        MinHeight="540" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7"
        Icon="app.ico"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <Grid Margin="20">
        <TabControl x:Name="MainTabs"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Padding" Value="14,8" />
                    <Setter Property="Foreground" Value="#1F2933" />
                </Style>
            </TabControl.Resources>

            <TabItem Header="Status">
                <Grid Margin="2,16,2,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="StatusCard"
                            Grid.Row="0"
                            Padding="24"
                            CornerRadius="14"
                            Background="#1B7F3B">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="StateText"
                                       Text="Working"
                                       HorizontalAlignment="Center"
                                       FontSize="42"
                                       FontWeight="Bold"
                                       Foreground="White" />
                            <TextBlock x:Name="StateDetailText"
                                       Text="Activity detected."
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       Foreground="White"
                                       Opacity="0.85" />
                             <TextBlock x:Name="TodayWorkTimeCardText"
                                        Text="Today: 0m 00s"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="White" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Last activity"
                                       FontSize="12"
                                       Foreground="#616E7C" />
                            <TextBlock x:Name="LastActivityText"
                                       Text="--:--:--"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2933" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Idle time / threshold"
                                       FontSize="12"
                                       Foreground="#616E7C" />
                            <TextBlock x:Name="IdleTimeText"
                                       Text="0m 00s / 15m 00s"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2933" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="FooterText"
                               Grid.Row="2"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#616E7C" />
                    <TextBlock x:Name="VersionText"
                               Grid.Row="2"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               FontSize="11"
                               Foreground="#9AA5B1" />
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,16,2,4">
                        <TextBlock Text="Timing"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2933" />
                        <TextBlock Text="How long the mouse may stay still before the state becomes Not working."
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="#616E7C" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Not working after"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#1F2933" />
                            <TextBox x:Name="TimeoutTextBox"
                                     Width="80"
                                     Margin="8,0"
                                     Padding="6,4"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     TextChanged="TimeoutTextBox_TextChanged" />
                            <TextBlock Text="minutes"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#1F2933" />
                        </StackPanel>

                        <TextBlock x:Name="TimeoutErrorText"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="#B3261E"
                                   Visibility="Collapsed" />

                        <Border Height="1" Margin="0,20,0,0" Background="#D9DEE3" />

                        <TextBlock Text="Startup"
                                   Margin="0,20,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2933" />
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Content="Start Work Monitor when I sign in"
                                  Margin="0,12,0,0"
                                  FontSize="14"
                                  Foreground="#1F2933" />
                        <TextBlock Text="Adds Work Monitor to your Windows user account's startup items. No administrator rights are needed."
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="#616E7C" />

                        <Border Height="1" Margin="0,20,0,0" Background="#D9DEE3" />

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="ApplyButton"
                                    Content="Apply"
                                    Click="ApplyButton_Click"
                                    IsDefault="True"
                                    Padding="24,8"
                                    FontSize="14" />
                            <Button x:Name="RestoreDefaultsButton"
                                    Content="Restore defaults"
                                    Click="RestoreDefaultsButton_Click"
                                    Margin="10,0,0,0"
                                    Padding="16,8"
                                    FontSize="14" />
                        </StackPanel>

                        <TextBlock x:Name="SaveMessageText"
                                   Margin="0,14,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="HistoryTab" Header="History">
                <Grid Margin="2,16,2,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <ComboBox x:Name="WeekComboBox"
                                  Width="200"
                                  Height="30"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="WeekComboBox_SelectionChanged" />
                        <Button Content="Refresh"
                                Click="RefreshHistoryButton_Click"
                                Margin="10,0,0,0"
                                Padding="14,6" />
                        <Button Content="Open folder"
                                Click="OpenHistoryFolderButton_Click"
                                Margin="8,0,0,0"
                                Padding="14,6" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HistorySummaryText"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2933" />
                        <TextBlock x:Name="CurrentSessionText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#616E7C" />
                    </Grid>

                    <TextBlock x:Name="HistoryErrorText"
                               Grid.Row="2"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#B3261E"
                               Visibility="Collapsed" />

                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Started" FontSize="12" Foreground="#616E7C" />
                        <TextBlock Grid.Column="1" Text="Stopped" FontSize="12" Foreground="#616E7C" />
                        <TextBlock Grid.Column="2" Text="Duration" FontSize="12" Foreground="#616E7C" />
                    </Grid>

                    <ListView x:Name="HistoryListView"
                              Grid.Row="4"
                              Margin="0,4,0,0"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="0,12,0,4"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2933" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding StartText}"
                                               FontSize="13"
                                               Foreground="#1F2933" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding StopText}"
                                               FontSize="13"
                                               Foreground="#1F2933" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DurationText}"
                                               FontSize="13"
                                               Foreground="#616E7C" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="HistoryEmptyText"
                               Grid.Row="4"
                               Text="No work sessions recorded for this week yet."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#616E7C"
                               Visibility="Collapsed" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
