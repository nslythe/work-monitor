<Window x:Class="work_monitor.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Work Monitor"
        Width="540"
        SizeToContent="Height"
        MaxHeight="640"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7"
        Icon="app.ico"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock x:Name="HeadingText"
                       Text="A new version is available"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#1F2933"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="VersionText"
                       Margin="0,6,0,0"
                       FontSize="14"
                       Foreground="#616E7C"
                       TextWrapping="Wrap" />

            <TextBlock Text="Release notes"
                       Margin="0,20,0,0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#1F2933" />

            <Border Margin="0,8,0,0"
                    Padding="12"
                    Background="White"
                    BorderBrush="#D9DEE3"
                    BorderThickness="1"
                    CornerRadius="6">
                <ScrollViewer MaxHeight="220"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="ReleaseNotesText"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#1F2933" />
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="ErrorText"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#B3261E"
                       Visibility="Collapsed" />

            <StackPanel x:Name="ProgressPanel"
                        Margin="0,16,0,0"
                        Visibility="Collapsed">
                <ProgressBar x:Name="DownloadProgressBar"
                             Height="8"
                             Minimum="0"
                             Maximum="100" />
                <TextBlock x:Name="ProgressText"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="#616E7C" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button x:Name="ViewReleaseButton"
                        Content="View release"
                        Click="ViewReleaseButton_Click"
                        Padding="14,7"
                        FontSize="13" />
                <Button x:Name="SkipButton"
                        Content="Skip this version"
                        Click="SkipButton_Click"
                        Margin="8,0,0,0"
                        Padding="14,7"
                        FontSize="13" />
                <Button x:Name="RemindLaterButton"
                        Content="Remind me later"
                        Click="RemindLaterButton_Click"
                        Margin="8,0,0,0"
                        Padding="14,7"
                        FontSize="13" />
                <Button x:Name="UpdateNowButton"
                        Content="Update now"
                        Click="UpdateNowButton_Click"
                        IsDefault="True"
                        Margin="8,0,0,0"
                        Padding="18,7"
                        FontSize="13"
                        FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
