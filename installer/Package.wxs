<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    Per-user install in the user profile: Scope="perUserOrMachine" makes this a dual-purpose
    package, and Windows Installer installs it for the current user when setup is not elevated.
    WiX authors ALLUSERS=2 and MSIINSTALLPERUSER=1 from that attribute; authoring those
    properties by hand causes WIX0091, and Scope="perUser" must not be added on top of it.
  -->
  <Package Name="Work Monitor"
           Manufacturer="Work Monitor"
           Version="$(var.AppVersion)"
           UpgradeCode="39F1071D-BC41-4445-B0B4-F6F7655053B5"
           Scope="perUserOrMachine"
           InstallerVersion="500"
           Language="1033"
           Compressed="yes">

    <SummaryInformation Manufacturer="Work Monitor"
                        Description="Tracks whether you are working and keeps a weekly history." />

    <!-- A newer version replaces an older one; the UpgradeCode never changes. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Work Monitor is already installed. Uninstall it before installing this older version."
                  AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallValidate" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\work monitor\app.ico" />

    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCONTACT" Value="Work Monitor" />

    <!-- The finish page offers to start the application right away. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Work Monitor" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!-- .NET Framework 4.8 or later is required; release 528040 is the first 4.8 release. -->
    <Property Id="NETFRAMEWORK48RELEASE">
      <RegistrySearch Id="NetFramework48Release"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full"
                      Name="Release"
                      Type="raw"
                      Bitness="always64" />
    </Property>

    <Launch Condition="Installed OR NETFRAMEWORK48RELEASE &gt;= &quot;#528040&quot;"
            Message="Work Monitor requires the .NET Framework 4.8 or later. Install it from https://dotnet.microsoft.com/download/dotnet-framework/net48 and then run this installer again." />

    <Feature Id="MainFeature" Title="Work Monitor" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="ApplicationShortcuts" />
    </Feature>

    <!--
      Ask a running copy to quit before any file is touched, so its current session is written
      to the history. On a first install the executable does not exist yet; the failure is
      ignored, which is why this action carries no condition.
    -->
    <CustomAction Id="QuitRunningApplication"
                  FileRef="WorkMonitorExeFile"
                  ExeCommand="--quit"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <CustomAction Id="LaunchApplication"
                  FileRef="WorkMonitorExeFile"
                  ExeCommand=""
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="QuitRunningApplication" Before="InstallValidate" />
      <!-- Only the interactive finish page offers the Launch check box; silent installs
           (UILevel 2) must never start the application. -->
      <Custom Action="LaunchApplication" After="InstallFinalize" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and UILevel = 5" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_Minimal" />
  </Package>
</Wix>
